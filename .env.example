NEXT_PUBLIC_FORMSPREE_ID_CONTACT=
NEXT_PUBLIC_FORMSPREE_ID_NEWSLETTER=

# Repo GitHub privé contenant les articles
BLOG_REPO_OWNER=
BLOG_REPO_NAME=
BLOG_REPO_BRANCH=main
BLOG_REPO_TOKEN=

# Secret à fournir en header x-sync-secret (ou ?secret=) pour déclencher /api/blog/sync
BLOG_SYNC_SECRET=

# URL du site déployé, utilisée par `npm run blog:sync -- --prod`
BLOG_SITE_URL=
